{
  "manifest_version": 3,
  "name": "Gӓdӓt",
  "version": "0.0.1",
  "description": "Gӓdӓt: a calm habit tracker unlocked with your fingerprint.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Gӓdӓt",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["http://localhost:3000/*"]
}
