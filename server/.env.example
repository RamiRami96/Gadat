DATABASE_URL=postgresql://gadat:gadat@localhost:5432/gadat
COOKIE_SECRET=change-me-to-another-long-random-string
RP_ID=localhost
RP_NAME=Gӓdӓt
ORIGIN=http://localhost:4200
PORT=3000
NODE_ENV=development
# Database for npm run test:e2e. Defaults to DATABASE_URL with "_test" added to the database name.
# TEST_DATABASE_URL=postgresql://gadat:gadat@localhost:5432/gadat_test

# Number of reverse-proxy hops to trust so rate limits see the real client IP.
# Leave unset (0) when the API is reached directly; set to 1 behind one proxy.
# TRUST_PROXY=1

# Max database connections per API instance (default 10). With N instances Postgres sees N times this.
# DB_POOL_MAX=10

# Log level (default info): fatal, error, warn, info, debug, trace, silent.
# LOG_LEVEL=info
# Bearer token for GET /api/metrics. Unset disables the endpoint. In production use a long
# random value (openssl rand -base64 32).
METRICS_TOKEN=dev-metrics-token-change-in-production
